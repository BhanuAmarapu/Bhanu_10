{
  "name": "cloud-dedup-pro",
  "version": "1.0.0",
  "description": "ML-Assisted Secure Hybrid Cloud Deduplication System",
  "main": "backend/run.py",
  "scripts": {
    "start:ml": "cd ml-service && ..\\.venv\\Scripts\\python -m uvicorn main:app --host 127.0.0.1 --port 8000",
    "start:backend": "cd backend && ..\\.venv\\Scripts\\python run.py",
    "start": "concurrently \"npm run start:ml\" \"npm run start:backend\"",
    "setup:venv": "python -m venv .venv --system-site-packages && .\\.venv\\Scripts\\pip install -r backend/requirements.txt -r ml-service/requirements.txt"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
